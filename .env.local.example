# It is recommended to generate a new secret for your application
# You can use the following command to generate a new secret:
# openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# API URL - Base URL for API calls
# For development: http://localhost:3000
# For production: your deployed domain (e.g., https://yourdomain.com)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Database Connection String
DATABASE_URL="postgresql://user:password@localhost:5432/mydatabase"

# Stripe API Keys
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY

# Cloudinary API Keys (if using Cloudinary for image uploads)
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Google Gemini API Key (free from https://aistudio.google.com)
# Used by the Magic Wand auto-fill feature on /sell
NEXT_PUBLIC_GEMINI_API_KEY=

# Email Configuration (for Nodemailer)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=user@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM=noreply@example.com